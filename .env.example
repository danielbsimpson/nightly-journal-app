# ─── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0.5

# ─── Whisper ───────────────────────────────────────────────────────────────
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# auto | cuda | cpu — auto prefers CUDA and falls back to CPU with a warning
WHISPER_DEVICE=auto
# Language code, or leave blank for auto-detect
WHISPER_LANGUAGE=en
# Recordings shorter than this are rejected before reaching the model
MIN_RECORDING_SECONDS=2

# ─── Storage ───────────────────────────────────────────────────────────────
JOURNALS_DIR=./journals
# true keeps the source recording alongside its entry.
# Cannot be applied retroactively — entries saved while false have no audio.
RETAIN_AUDIO=false

# ─── Journaling ────────────────────────────────────────────────────────────
# A journal day runs from this hour to the same hour next morning, local time,
# so a 00:40 entry counts towards the night it describes.
# Changing this re-buckets existing entries and can change your streak.
DAY_BOUNDARY_HOUR=4

# ─── Backend ───────────────────────────────────────────────────────────────
# Keep this on loopback. The API is unauthenticated: binding to 0.0.0.0 exposes
# a read/write journal to everyone on your network.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Note: the mood vocabulary is deliberately not configurable. See README.
